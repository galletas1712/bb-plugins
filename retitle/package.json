{
  "name": "bb-plugin-retitle",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Retitle",
